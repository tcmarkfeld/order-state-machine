{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OrderStateMachine.Api/bin/Debug/net10.0/OrderStateMachine.Api.dll",
      "cwd": "${workspaceFolder}/src/OrderStateMachine.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5251"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "API (payment declined)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
